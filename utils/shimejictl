            # Mascot/Information/Artist
            # Mascot/Information/Artist
            artist = root.find("Information/Artist")
            if artist is not None:
                manifest["artist"] = artist.text

            # Mascot/Information/Scripter
            # Mascot/Information/Scripter
            scripter = root.find("Information/Scripter")
            if scripter is not None:

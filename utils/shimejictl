                    encode_img(img, False, tempf.name)
                    tempf = open(tempf.name, "rb")
                    tarinfo = tarfile.TarInfo("assets/" + os.path.join(path.removeprefix(os.path.join(instance_root, "img", prototype)), file.removesuffix(".png")\
